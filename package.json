{
  "name": "course-evaluation-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React and Node.js evaluation reporting with SQL Server stored procedures and a portable SQLite preview.",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "npm run build && npm start",
    "test": "node --test test/report.test.js",
    "test:sqlserver": "node --env-file-if-exists=.env --test test/sqlserver.test.js",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-sqlserver.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "mssql": "12.0.0"
  },
  "devDependencies": {
    "vite": "8.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "@playwright/test": "1.62.1"
  }
}
