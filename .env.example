# Default preview needs no configuration or database installation.
DB_DRIVER=sqlite
PORT=4100
# To connect to your own disposable SQL Server database, set DB_DRIVER=mssql.
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=EvaluationDemo
SQL_USER=sa
SQL_PASSWORD=replace-with-your-own-password
SQL_ENCRYPT=true
# Use true only for a local development server with a self-signed certificate.
SQL_TRUST_CERTIFICATE=false
